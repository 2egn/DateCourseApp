{
  "name": "datecourseapp-team-docs",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-11",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{"name": "BOARD", "class_name": "TaskBoard"}, {"name": "AGENT_ACCESS", "class_name": "AgentAccess"}]
  },
  "migrations": [{"tag": "task-board-v1", "new_sqlite_classes": ["TaskBoard"]}, {"tag": "agent-access-v1", "new_sqlite_classes": ["AgentAccess"]}],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "SITE_ORIGIN": "https://datecourseapp-team-docs.ate-ourse-pp.workers.dev",
    "GITHUB_CLIENT_ID": "Ov23lidunC8X3WN4PSOb"
  }
}
