<?xml version="1.0" encoding="UTF-8"?>
<!-- JavaFX 클래스들 -->
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>

<!--
  저장한 코스 화면 (SavedCourseController와 연결)
  구성 순서: [상단] 제목 → [왼쪽] 코스 목록 → [가운데] 상세(제목 → 지도 → 표 → 메시지 → 버튼)
  Java 컨트롤러의 필드/메서드도 같은 순서로 정리되어 있음
-->
<BorderPane fx:id="savedCourseRoot" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.datecourse.controller.SavedCourseController"
            prefWidth="920" prefHeight="620">

    <!-- ========== 1. 상단: 화면 제목 ========== -->
    <top>
        <Label text="저장한 코스" styleClass="title,saved-course-header"/>
    </top>

    <!-- ========== 2. 왼쪽: 저장한 코스 목록 ========== -->
    <left>
        <VBox fx:id="courseListPane" styleClass="saved-course-list-pane"
              prefWidth="380" minWidth="240" maxWidth="420">
            <!-- 코스 목록 -->
            <ListView fx:id="courseList" VBox.vgrow="ALWAYS" styleClass="saved-course-list"/>
            <!-- 코스가 하나도 없을 때 보이는 안내 문구 -->
            <Label fx:id="emptyLabel" text="저장한 코스가 없어요." visible="false"/>
            <!-- 새 코스 만들기 버튼 -->
            <Button text="새 코스" onAction="#onNewCourseClick"
                    styleClass="primary" maxWidth="Infinity"/>
        </VBox>
    </left>

    <!-- ========== 3. 가운데: 선택한 코스의 상세 정보 ========== -->
    <center>
        <VBox styleClass="saved-course-detail">

            <!-- 3-1. 상세 제목 -->
            <Label fx:id="detailTitle" text="코스를 선택해주세요" styleClass="subtitle"/>

            <!-- 3-2. 지도 영역 (지도 위에 안내 문구/재시도 버튼이 겹쳐서 표시됨) -->
            <StackPane fx:id="mapPane" minHeight="180" prefHeight="420" maxHeight="Infinity" VBox.vgrow="ALWAYS">
                <WebView fx:id="previewMap" accessibleText="저장한 코스의 실시간 지도"/>
                <VBox fx:id="mapNotice" styleClass="map-notice" maxWidth="440">
                    <Label fx:id="mapStatus" text="실시간 지도를 불러오고 있어요…" wrapText="true"/>
                    <Button fx:id="mapRetry" text="지도 다시 불러오기" onAction="#onMapRetry"
                            visible="false" managed="false"/>
                </VBox>
            </StackPane>

            <!-- 3-3. 하단 정보 표 (왼쪽: 코스 요약 / 오른쪽: 장소 목록) -->
            <HBox styleClass="saved-course-bottom"
                  minHeight="170" prefHeight="210" maxHeight="260">
                <!-- 왼쪽: 코스 요약 정보 표 -->
                <TableView fx:id="summaryTable" styleClass="saved-course-table"
                           minWidth="230" prefWidth="310" minHeight="120" prefHeight="210"
                           maxHeight="Infinity" HBox.hgrow="NEVER">
                    <columns>
                        <TableColumn fx:id="summaryLabelColumn" text="장소 정보" prefWidth="96" minWidth="82" maxWidth="120"/>
                        <TableColumn fx:id="summaryValueColumn" text="내용" prefWidth="200" minWidth="130"/>
                    </columns>
                </TableView>
                <!-- 오른쪽: 코스에 포함된 장소 표 -->
                <TableView fx:id="placeTable" styleClass="saved-course-table"
                           minWidth="360" prefWidth="500" minHeight="120" prefHeight="210"
                           maxHeight="Infinity" HBox.hgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="placeOrderColumn" text="순서" prefWidth="52" minWidth="46" maxWidth="60"/>
                        <TableColumn fx:id="placeNameColumn" text="장소" prefWidth="140" minWidth="90"/>
                        <TableColumn fx:id="placePriceColumn" text="가격" prefWidth="140" minWidth="95"/>
                        <TableColumn fx:id="placeAddressColumn" text="주소" prefWidth="220" minWidth="100"/>
                    </columns>
                </TableView>
            </HBox>

            <!-- 3-4. 처리 중 / 오류 안내 메시지 -->
            <Label fx:id="messageLabel" styleClass="muted"/>

            <!-- 3-5. 버튼 영역 (불러오기 / 새로고침 / 이름 변경 / 삭제) -->
            <FlowPane styleClass="saved-course-actions">
                <Button fx:id="openButton" text="이 코스 불러오기" onAction="#onOpenClick" styleClass="primary"/>
                <Button fx:id="refreshButton" text="새로고침" onAction="#onRefreshClick" styleClass="secondary"/>
                <Button fx:id="renameButton" text="이름 변경" onAction="#onRenameClick" styleClass="secondary"/>
                <Button fx:id="deleteButton" text="삭제" onAction="#onDeleteClick" styleClass="danger"/>
            </FlowPane>
        </VBox>
    </center>
</BorderPane>
