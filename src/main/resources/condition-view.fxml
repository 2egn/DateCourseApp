<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.web.WebView?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            stylesheets="@style.css"
            styleClass="condition-screen"
            fx:controller="com.datecourse.controller.ConditionController"
            prefWidth="920" prefHeight="620">

    <left>
        <StackPane fx:id="conditionDrawer" prefWidth="280" minWidth="0" maxWidth="-Infinity" alignment="CENTER_LEFT">
        <ScrollPane fx:id="conditionScroll" fitToWidth="true" hbarPolicy="NEVER"
                    prefWidth="280" minWidth="280" maxWidth="280" styleClass="condition-scroll">
        <VBox spacing="10" styleClass="condition-form">
            <padding>
                <Insets top="20" right="16" bottom="20" left="16"/>
            </padding>

            <Label text="코스 조건" styleClass="condition-title" wrapText="true"/>

            <Label text="예산 (원)"/>
            <TextField fx:id="budgetField" promptText="예: 50000"/>

            <Label text="인원"/>
            <TextField fx:id="peopleField" promptText="예: 2"/>

            <Label text="카테고리 · 복수 선택"/>
            <FlowPane fx:id="categoryPane" hgap="8" vgap="8"/>

            <Label fx:id="radiusLabel" text="반경: 500m"/>
            <Slider fx:id="radiusSlider" min="200" max="2000" value="500"/>

            <Label fx:id="countLabel" visible="false" managed="false" wrapText="true"/>

            <Label fx:id="errorLabel" styleClass="error" wrapText="true"/>
            <Button text="코스 추천받기" onAction="#onRecommendClick" maxWidth="Infinity"/>
        </VBox>
        </ScrollPane>
        </StackPane>
    </left>

    <center>
        <VBox spacing="8">
            <padding>
                <Insets top="12" right="12" bottom="12" left="12"/>
            </padding>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button fx:id="drawerToggle" text="‹ 조건 접기" onAction="#onToggleConditions"
                        styleClass="drawer-toggle" minWidth="100"/>
                <Label fx:id="hintLabel" text="부산 · 출발 장소 선택" styleClass="muted" wrapText="true" HBox.hgrow="ALWAYS"/>
            </HBox>
            <StackPane fx:id="mapPane" VBox.vgrow="ALWAYS">
                <WebView fx:id="mapView"/>
            </StackPane>
        </VBox>
    </center>
</BorderPane>
